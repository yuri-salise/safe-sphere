# ==============================================================================
# Safe Sphere - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   PowerShell: Copy-Item .env.example .env.local
#   Bash:       cp .env.example .env.local
# Never commit .env.local to version control.

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Branding & Platform Metadata
NEXT_PUBLIC_APP_NAME="Safe Sphere"
NEXT_PUBLIC_APP_DESCRIPTION="Next-Gen Real-Time Disaster Coordination & Aid Transparency Platform"

# Supabase Authentication & Database
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# MapLibre Configuration
# Default is OpenFreeMap Liberty. For high-contrast dark tactical maps, you can also use:
#   https://tiles.openfreemap.org/styles/dark
#   https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Geographic Operations Center Default Coordinates
# Default is set to Central Mindanao [Lng: 125.0499, Lat: 7.8582]
NEXT_PUBLIC_MAP_DEFAULT_LNG=125.0499
NEXT_PUBLIC_MAP_DEFAULT_LAT=7.8582
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=14

# Simulation & Demo Data
# Set to 'true' to explore live incident markers & metrics without needing database records.
# Set to 'false' for production deployments.
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
